# Copy this file to server.env and fill in your own values. Never commit server.env.

# PostgreSQL connection
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/rahmanis

# Gmail account that sends password reset emails (use a Google app password)
EMAIL_USER=
EMAIL_PASS=

# Long random text used to sign login sessions
SECRET=

# First admin, created by "npm run migrate" when there is no admin yet
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
